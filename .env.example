# ==============================================================================
# Discord LLM Gateway Environment Configuration
# ==============================================================================

# Discord Application Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DEDICATED_CHAT_CHANNEL_ID=

# Supabase PostgreSQL Backend
# (service_role key is used server-side to safely bypass RLS policies)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application-Level Fernet Encryption Master Key
# Generate via: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=your_32_byte_url_safe_base64_fernet_key_here

# Demo Mode LLM Credentials (Shared recruiter / demo quota)
DEMO_GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_DEMO_MODEL=gemini/gemini-3.1-flash-lite

# Guardrails & Token Limits
MAX_PROMPT_CHARS=800
MAX_OUTPUT_TOKENS=600

# Optional Custom System Prompt Default
# DEFAULT_SYSTEM_PROMPT=You are a sharp, witty, and concise AI assistant in a shared Discord server.
